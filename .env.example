# Google Cloud project & region for Vertex AI (Gemini calls use Vertex AI +
# Application Default Credentials -- no AI Studio API key). Authenticate once
# with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1

# GCS bucket used to stage local audio/video for Gemini (not needed for
# YouTube URLs or --engine whisper). If using Gemini Enterprise, deploy.sh
# automatically provisions gs://${GOOGLE_CLOUD_PROJECT}-meeting-transcribe:
#   gcloud storage buckets create gs://your-gcp-project-id-meeting-transcribe --location=us-central1
MEETING_STORAGE_BUCKET=your-gcp-project-id-meeting-transcribe

# Model Selection (defaults: gemini-3.5-transcribe-preview and gemini-3.8-flash)
TRANSCRIBE_MODEL=gemini-3.5-transcribe-preview
SUMMARY_MODEL=gemini-3.8-flash
