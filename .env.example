# Google Cloud project & region for Vertex AI (Gemini calls use Vertex AI +
# Application Default Credentials -- no AI Studio API key). Authenticate once
# with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# GCS bucket used to stage local audio/video for Gemini (not needed for
# YouTube URLs or --engine whisper). Provision one with terraform/:
#   cd terraform && terraform init && terraform apply -var="project_id=your-gcp-project-id"
MEETING_STORAGE_BUCKET=your-bucket-name
