# ==============================================================================
# Gemini Enterprise Agent Configuration
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Platform Project & Region
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1

# 2. Meeting Storage Bucket Name (GCS)
# If left empty, deploy.sh or Terraform will provision one for you (see ../terraform/).
# Gemini calls always use Vertex AI + Application Default Credentials -- there
# is no AI Studio API key option.
MEETING_STORAGE_BUCKET=

# 3. Model Selection
TRANSCRIBE_MODEL=gemini-3.5-transcribe-preview
SUMMARY_MODEL=gemini-3.8-flash
