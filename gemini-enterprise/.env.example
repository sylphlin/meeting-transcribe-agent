# ==============================================================================
# Gemini Enterprise Agent Configuration
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Platform Project & Region
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# 2. Meeting Storage Bucket Name (GCS)
# If left empty, deploy.sh or Terraform will provision: {project_id}-meeting-data
# or use the output of the terraform deployment.
MEETING_STORAGE_BUCKET=

# 3. Optional: Google AI Studio API Key (Leave commented out to use Vertex AI ADC)
# GEMINI_API_KEY=your_gemini_api_key_here
