# ==============================================================================
# Gemini Enterprise Agent Configuration
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Platform Project & Region
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1

# 2. Meeting Storage Bucket Name (GCS)
# If left empty, deploy.sh automatically provisions gs://meeting-transcribe-${GCP_PROJECT}
# using 100% native gcloud with lifecycle and CORS rules.
# Gemini calls always use Vertex AI + Application Default Credentials -- there
# is no AI Studio API key option.
MEETING_STORAGE_BUCKET=

# 3. Model Selection
TRANSCRIBE_MODEL=gemini-3.5-transcribe-preview
SUMMARY_MODEL=gemini-3.8-flash

# 4. Gemini Enterprise Integration (Optional)
# Specify your Gemini Enterprise App full resource name or short engine ID:
# Full resource name:
#   projects/{project_number}/locations/global/collections/default_collection/engines/{engine_id}
# Or short engine ID (deploy.sh will automatically construct the full path):
#   GEMINI_ENTERPRISE_APP_ID=my-meeting-app
GEMINI_ENTERPRISE_APP_ID=
GEMINI_ENTERPRISE_LOCATION=global
