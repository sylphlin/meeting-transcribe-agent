# Google Cloud Project Configuration
project_id = "YOUR_GCP_PROJECT_ID"
region     = "us-central1"

# Storage Bucket Configuration
# Leave blank to auto-generate: {project_id}-meeting-transcribe-{random_hex}
bucket_name          = ""
cors_max_age_seconds = 86400  # 24 hours

# Retention Policies
# raw/ mirrors the old Files API's ephemeral upload behavior (auto-delete ~48h);
# minutes/ and players/ are the generated deliverables, kept a bit longer.
raw_retention_days    = 2   # Purge raw media (fed to Gemini) after 2 days
output_retention_days = 14  # Purge generated minutes/player deliverables after 14 days

# Extra IAM members granted object-admin access on the bucket, beyond the
# dedicated service account this module creates. Useful for local/personal use
# (e.g. the Antigravity CLI) where you upload as yourself via ADC rather than
# a service account. Leave empty if your own project role already covers it.
# bucket_editors = ["user:you@example.com"]
